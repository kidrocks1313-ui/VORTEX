{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @workspace/discord-bot run typecheck"
  },
  "deploy": {
    "startCommand": "pnpm --filter @workspace/discord-bot run dev",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}