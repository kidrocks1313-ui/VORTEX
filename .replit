modules = ["nodejs-24"]
[deployment]
run = ["pnpm", "--filter", "@workspace/discord-bot", "run", "dev"]

[workflows]
run = "Discord Bot"
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"
[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Discord Bot"

[[workflows.workflow]]
name = "Discord Bot"
mode = "parallel"
author = "agent"
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/discord-bot run dev"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
mode = "parallel"
[[workflows.workflow.tasks]]
task = "api"

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
DISCORD_CLIENT_ID = "1524359451929481316"
DISCORD_OWNER_IDS = "1392224478175690752,916746055268302848"

[[ports]]
localPort = 8082
externalPort = 80
